{
	"info": {
		"_postman_id": "d8740b8c-6505-49a0-b75a-cbcd5c72df5e",
		"name": "Game Promotion API - Deduction Verification Flow",
		"description": "Enhanced deduction verification testing:\n\n**Flow Overview:**\n- Use existing promotion (no creation needed)\n- Claim promotion (record initial state)\n- Deduct bonus item → Verify deduction\n- Multiple deductions → Final verification\n\n**Key Features:**\n- Focused testing of deduction accuracy using existing promotions\n- State tracking and verification\n- Multiple deduction scenarios\n- Detailed field integrity checks\n- Response format validation\n\n**Setup Required:**\n- Set existingPromotionId variable to an existing promotion ID",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Claim Existing Promotion (Initial State)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Initial promotion state verification', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('promotion');",
							"    pm.expect(jsonData.promotion).to.have.property('playerId');",
							"    pm.expect(jsonData.promotion).to.have.property('remainingBonusItems');",
							"    pm.expect(jsonData.promotion).to.have.property('initialBonusItem');",
							"    pm.expect(jsonData.promotion.remainingBonusItems).to.be.a('number');",
							"    pm.expect(jsonData.promotion.remainingBonusItems).to.be.greaterThan(0);",
							"});",
							"",
							"pm.test('Save initial state for comparison', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('initialRemainingItems', jsonData.promotion.remainingBonusItems);",
							"    pm.collectionVariables.set('initialBonusItemCount', jsonData.promotion.initialBonusItem);",
							"    pm.collectionVariables.set('existingPromotionId', jsonData.promotion.promotionId);",
							"    console.log('Using existing promotion with remaining items:', jsonData.promotion.remainingBonusItems);",
							"    console.log('Initial bonus item count:', jsonData.promotion.initialBonusItem);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/player-promotions/claim-promotion",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"player-promotions",
						"claim-promotion"
					]
				},
				"description": "Claim the promotion and record initial state"
			},
			"response": []
		},
		{
			"name": "2. Deduct Bonus Item (Test Deduction)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Deduction successful', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"});",
							"",
							"pm.test('Record deduction for verification', function () {",
							"    const initialItems = parseInt(pm.collectionVariables.get('initialRemainingItems'));",
							"    pm.collectionVariables.set('expectedRemainingItems', initialItems - 1);",
							"    console.log('Deducted 1 item. Expected remaining:', initialItems - 1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"operatorId\": \"{{operatorId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"promotionId\": \"{{existingPromotionId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/player-promotions/deduct-bonus-item",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"player-promotions",
						"deduct-bonus-item"
					]
				},
				"description": "Deduct one bonus item to test the deduction logic"
			},
			"response": []
		},
		{
			"name": "3. Verify Deduction - Claim Promotion Again",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Deduction verification - remaining items decreased', function () {",
							"    const jsonData = pm.response.json();",
							"    const expectedRemaining = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
							"    const actualRemaining = jsonData.promotion.remainingBonusItems;",
							"    const initialCount = parseInt(pm.collectionVariables.get('initialBonusItemCount'));",
							"    ",
							"    pm.expect(jsonData).to.have.property('promotion');",
							"    pm.expect(actualRemaining).to.equal(expectedRemaining);",
							"    ",
							"    console.log('✅ Deduction verified!');",
							"    console.log('Initial items:', initialCount);",
							"    console.log('Items after deduction:', actualRemaining);",
							"    console.log('Expected items:', expectedRemaining);",
							"});",
							"",
							"pm.test('lastUsedDate updated after deduction', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.promotion.lastUsedDate).to.not.be.null;",
							"    const lastUsedDate = new Date(jsonData.promotion.lastUsedDate);",
							"    const now = new Date();",
							"    const timeDiff = Math.abs(now - lastUsedDate);",
							"    pm.expect(timeDiff).to.be.below(60000); // Within 1 minute",
							"});",
							"",
							"pm.test('Other promotion fields unchanged', function () {",
							"    const jsonData = pm.response.json();",
							"    const initialCount = parseInt(pm.collectionVariables.get('initialBonusItemCount'));",
							"    pm.expect(jsonData.promotion).to.have.property('initialBonusItem', initialCount);",
							"    pm.expect(jsonData.promotion).to.have.property('playerId');",
							"    pm.expect(jsonData.promotion).to.have.property('operatorId');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/player-promotions/claim-promotion",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"player-promotions",
						"claim-promotion"
					]
				},
				"description": "Claim promotion again to verify the deduction was correctly applied"
			},
			"response": []
		},
		{
			"name": "4. Multiple Deductions Test",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Second deduction successful', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"});",
							"",
							"pm.test('Update expected count for multiple deductions', function () {",
							"    const currentExpected = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
							"    pm.collectionVariables.set('expectedRemainingItems', currentExpected - 1);",
							"    console.log('After second deduction, expected remaining:', currentExpected - 1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"operatorId\": \"{{operatorId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"promotionId\": \"{{existingPromotionId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/player-promotions/deduct-bonus-item",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"player-promotions",
						"deduct-bonus-item"
					]
				},
				"description": "Perform a second deduction to test multiple deductions"
			},
			"response": []
		},
		{
			"name": "5. Final Deduction Verification",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Final deduction verification - multiple deductions', function () {",
							"    const jsonData = pm.response.json();",
							"    const expectedRemaining = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
							"    const actualRemaining = jsonData.promotion.remainingBonusItems;",
							"    const initialCount = parseInt(pm.collectionVariables.get('initialBonusItemCount'));",
							"    const initialRemaining = parseInt(pm.collectionVariables.get('initialRemainingItems'));",
							"    ",
							"    pm.expect(actualRemaining).to.equal(expectedRemaining);",
							"    pm.expect(actualRemaining).to.equal(initialRemaining - 2); // 2 deductions performed",
							"    ",
							"    console.log('✅ Multiple deductions verified!');",
							"    console.log('Final remaining items:', actualRemaining);",
							"    console.log('Total deductions: 2');",
							"    console.log('Items progression:', initialRemaining, '→', (initialRemaining - 1), '→', actualRemaining);",
							"});",
							"",
							"pm.test('Complete deduction flow summary', function () {",
							"    const initialCount = parseInt(pm.collectionVariables.get('initialBonusItemCount'));",
							"    const initialRemaining = parseInt(pm.collectionVariables.get('initialRemainingItems'));",
							"    const finalRemaining = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
							"    ",
							"    console.log('');",
							"    console.log('🎉 Enhanced Deduction Verification Flow Completed Successfully!');",
							"    console.log('='.repeat(60));",
							"    console.log('✅ Used existing promotion with', initialCount, 'bonus items');",
							"    console.log('✅ Verified initial claim state (', initialRemaining, 'items available)');",
							"    console.log('✅ Performed first deduction (', initialRemaining, '→', (initialRemaining - 1), ')');",
							"    console.log('✅ Verified deduction applied correctly');",
							"    console.log('✅ Confirmed lastUsedDate was updated');",
							"    console.log('✅ Performed second deduction (', (initialRemaining - 1), '→', finalRemaining, ')');",
							"    console.log('✅ Verified multiple deductions work correctly');",
							"    console.log('✅ All promotion fields maintained integrity');",
							"    console.log('✅ Response format validated (no success codes)');",
							"    console.log('='.repeat(60));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/player-promotions/claim-promotion",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"player-promotions",
						"claim-promotion"
					]
				},
				"description": "Final verification of the complete deduction flow"
			},
			"response": []
		}
	],
