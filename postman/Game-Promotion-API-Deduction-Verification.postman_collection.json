{
  "info": {
    "name": "Game Promotion API - Deduction Verification Flow",
    "description": "Enhanced deduction verification testing:\n\n**Flow Overview:**\n- Create promotion (25 bonus items)\n- Claim promotion (record initial state)\n- Deduct bonus item → Verify deduction\n- Multiple deductions → Final verification\n\n**Key Features:**\n- Focused testing of deduction accuracy\n- State tracking and verification\n- Multiple deduction scenarios\n- Detailed field integrity checks\n- Response format validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "operatorId",
      "value": "operator123",
      "type": "string"
    },
    {
      "key": "siteName",
      "value": "testsite",
      "type": "string"
    },
    {
      "key": "currencyGroup",
      "value": "USD",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "1001",
      "type": "string"
    },
    {
      "key": "testRunId",
      "value": "",
      "type": "string"
    },
    {
      "key": "deductionTestPromotionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "deductionTestPlayerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialRemainingItems",
      "value": "",
      "type": "string"
    },
    {
      "key": "expectedRemainingItems",
      "value": "",
      "type": "string"
    },
    {
      "key": "claimedDeductionPromotionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Promotion for Deduction Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has promotion data', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('_id');",
              "    pm.expect(jsonData).to.have.property('code');",
              "    pm.expect(jsonData).to.have.property('bonusItemCount', 25);",
              "    pm.expect(jsonData).to.have.property('operatorId');",
              "});",
              "",
              "pm.test('Save deduction test promotion ID', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('deductionTestPromotionId', jsonData._id);",
              "    pm.collectionVariables.set('deductionTestPlayerId', 'deduct_test_player_' + pm.collectionVariables.get('testRunId'));",
              "    console.log('Created promotion for deduction test:', jsonData._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Deduction Test Promotion\",\n  \"code\": \"DEDUCT_TEST_{{$timestamp}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"startDate\": \"{{$isoTimestamp}}\",\n  \"endDate\": \"2024-12-31T23:59:59.000Z\",\n  \"bonusItemCount\": 25,\n  \"currencyGroups\": [\"{{currencyGroup}}\"],\n  \"offeredSiteNames\": [\"{{siteName}}\"],\n  \"offeredPlayerIds\": [],\n  \"gameConfigType\": 2,\n  \"gameIds\": [{{gameId}}]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/promotions",
          "host": ["{{baseUrl}}"],
          "path": ["promotions"]
        },
        "description": "Create a new promotion specifically for testing deduction verification"
      }
    },
    {
      "name": "2. Claim Promotion (Initial State)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Initial promotion state verification', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('promotion');",
              "    pm.expect(jsonData.promotion).to.have.property('playerId', pm.collectionVariables.get('deductionTestPlayerId'));",
              "    pm.expect(jsonData.promotion).to.have.property('remainingBonusItems', 25);",
              "    pm.expect(jsonData.promotion).to.have.property('initialBonusItem', 25);",
              "    pm.expect(jsonData.promotion.lastUsedDate).to.be.null;",
              "});",
              "",
              "pm.test('Save initial state for comparison', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('initialRemainingItems', jsonData.promotion.remainingBonusItems);",
              "    pm.collectionVariables.set('claimedDeductionPromotionId', jsonData.promotion.promotionId);",
              "    console.log('Initial remaining items:', jsonData.promotion.remainingBonusItems);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": \"{{deductionTestPlayerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/player-promotions/claim-promotion",
          "host": ["{{baseUrl}}"],
          "path": ["player-promotions", "claim-promotion"]
        },
        "description": "Claim the promotion and record initial state"
      }
    },
    {
      "name": "3. Deduct Bonus Item (Test Deduction)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Deduction successful', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success', true);",
              "    pm.expect(jsonData).to.not.have.property('code');",
              "    pm.expect(jsonData).to.not.have.property('message');",
              "});",
              "",
              "pm.test('Record deduction for verification', function () {",
              "    const initialItems = parseInt(pm.collectionVariables.get('initialRemainingItems'));",
              "    pm.collectionVariables.set('expectedRemainingItems', initialItems - 1);",
              "    console.log('Deducted 1 item. Expected remaining:', initialItems - 1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operatorId\": \"{{operatorId}}\",\n  \"playerId\": \"{{deductionTestPlayerId}}\",\n  \"promotionId\": \"{{deductionTestPromotionId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/player-promotions/deduct-bonus-item",
          "host": ["{{baseUrl}}"],
          "path": ["player-promotions", "deduct-bonus-item"]
        },
        "description": "Deduct one bonus item to test the deduction logic"
      }
    },
    {
      "name": "4. Verify Deduction - Claim Promotion Again",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Deduction verification - remaining items decreased', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedRemaining = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
              "    const actualRemaining = jsonData.promotion.remainingBonusItems;",
              "    ",
              "    pm.expect(jsonData).to.have.property('promotion');",
              "    pm.expect(actualRemaining).to.equal(expectedRemaining);",
              "    pm.expect(actualRemaining).to.equal(24); // 25 - 1 = 24",
              "    ",
              "    console.log('✅ Deduction verified!');",
              "    console.log('Initial items: 25');",
              "    console.log('Items after deduction:', actualRemaining);",
              "    console.log('Expected items:', expectedRemaining);",
              "});",
              "",
              "pm.test('lastUsedDate updated after deduction', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.promotion.lastUsedDate).to.not.be.null;",
              "    const lastUsedDate = new Date(jsonData.promotion.lastUsedDate);",
              "    const now = new Date();",
              "    const timeDiff = Math.abs(now - lastUsedDate);",
              "    pm.expect(timeDiff).to.be.below(60000); // Within 1 minute",
              "});",
              "",
              "pm.test('Other promotion fields unchanged', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.promotion).to.have.property('initialBonusItem', 25);",
              "    pm.expect(jsonData.promotion).to.have.property('playerId', pm.collectionVariables.get('deductionTestPlayerId'));",
              "    pm.expect(jsonData.promotion).to.have.property('operatorId', pm.collectionVariables.get('operatorId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": \"{{deductionTestPlayerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/player-promotions/claim-promotion",
          "host": ["{{baseUrl}}"],
          "path": ["player-promotions", "claim-promotion"]
        },
        "description": "Claim promotion again to verify the deduction was correctly applied"
      }
    },
    {
      "name": "5. Multiple Deductions Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Second deduction successful', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success', true);",
              "});",
              "",
              "pm.test('Update expected count for multiple deductions', function () {",
              "    const currentExpected = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
              "    pm.collectionVariables.set('expectedRemainingItems', currentExpected - 1);",
              "    console.log('After second deduction, expected remaining:', currentExpected - 1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operatorId\": \"{{operatorId}}\",\n  \"playerId\": \"{{deductionTestPlayerId}}\",\n  \"promotionId\": \"{{deductionTestPromotionId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/player-promotions/deduct-bonus-item",
          "host": ["{{baseUrl}}"],
          "path": ["player-promotions", "deduct-bonus-item"]
        },
        "description": "Perform a second deduction to test multiple deductions"
      }
    },
    {
      "name": "6. Final Deduction Verification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Final deduction verification - multiple deductions', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedRemaining = parseInt(pm.collectionVariables.get('expectedRemainingItems'));",
              "    const actualRemaining = jsonData.promotion.remainingBonusItems;",
              "    ",
              "    pm.expect(actualRemaining).to.equal(expectedRemaining);",
              "    pm.expect(actualRemaining).to.equal(23); // 25 - 2 = 23",
              "    ",
              "    console.log('✅ Multiple deductions verified!');",
              "    console.log('Final remaining items:', actualRemaining);",
              "    console.log('Total deductions: 2');",
              "    console.log('Items used: 25 → 24 → 23');",
              "});",
              "",
              "pm.test('Complete deduction flow summary', function () {",
              "    console.log('');",
              "    console.log('🎉 Enhanced Deduction Verification Flow Completed Successfully!');",
              "    console.log('='.repeat(60));",
              "    console.log('✅ Created promotion with 25 bonus items');",
              "    console.log('✅ Verified initial claim state (25 items, no lastUsedDate)');",
              "    console.log('✅ Performed first deduction (25 → 24)');",
              "    console.log('✅ Verified deduction applied correctly');",
              "    console.log('✅ Confirmed lastUsedDate was updated');",
              "    console.log('✅ Performed second deduction (24 → 23)');",
              "    console.log('✅ Verified multiple deductions work correctly');",
              "    console.log('✅ All promotion fields maintained integrity');",
              "    console.log('✅ Response format validated (no success codes)');",
              "    console.log('='.repeat(60));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": \"{{deductionTestPlayerId}}\",\n  \"operatorId\": \"{{operatorId}}\",\n  \"siteName\": \"{{siteName}}\",\n  \"currencyGroup\": \"{{currencyGroup}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/player-promotions/claim-promotion",
          "host": ["{{baseUrl}}"],
          "path": ["player-promotions", "claim-promotion"]
        },
        "description": "Final verification of the complete deduction flow"
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set dynamic values for each test run",
          "if (!pm.collectionVariables.get('testRunId')) {",
          "    pm.collectionVariables.set('testRunId', Date.now());",
          "}",
          "",
          "console.log('🎯 Starting Enhanced Deduction Verification Flow Tests');",
          "console.log('Test Run ID:', pm.collectionVariables.get('testRunId'));",
          "console.log('Target API:', pm.collectionVariables.get('baseUrl'));"
        ]
      }
    }
  ]
}
