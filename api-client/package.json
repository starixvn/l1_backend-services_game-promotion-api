{
  "name": "@sc/game-promotion-api-client",
  "version": "1.0.1-beta.20",
  "description": "Node.js API client for Game Promotion API supporting player-promotion and promotion-ticket routes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "if exist dist rmdir /s /q dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "lint": "eslint **/*.ts",
    "lint:fix": "eslint **/*.ts --fix",
    "reg": "npm set registry https://npm.lumigame.com",
    "verpatch": "npm version patch",
    "verminor": "npm version minor",
    "betaver": "npm version prerelease --preid beta",
    "pub": "npm publish --registry https://npm.lumigame.com",
    "pubbeta": "npm publish --registry https://npm.lumigame.com --tag beta"
  },
  "keywords": [
    "api-client",
    "game-promotion",
    "nodejs",
    "typescript",
    "axios"
  ],
  "author": "Pentagon",
  "license": "Pentagon",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.2",
    "ts-jest": "^29.1.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://git3.nexdev.net/l1/backend-services/game-promotion-api.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
