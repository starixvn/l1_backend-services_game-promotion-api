              "    pm.expect(jsonData.promotion).to.have.property('totalWinAmount', 0);",
              "    pm.expect(jsonData.promotion).to.have.property('minRequiredTurnover', 0);",
              "    pm.expect(jsonData.promotion).to.have.property('turnoverMultiplier', 25);",
              "});",
              "",
              "pm.test('Save promotion info for later use', function () {",
              "    const jsonData = pm.response.json();",
